# systemd unit to run Hearth on a Linux VPS without Docker.
# Copy to /etc/systemd/system/hearth.service, fix the paths/user, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now hearth
[Unit]
Description=Hearth chat server
After=network.target

[Service]
Type=simple
User=hearth
WorkingDirectory=/opt/hearth
ExecStart=/usr/bin/node server/index.js
Restart=on-failure
# Each open app window is one connection; the usual default (1024) would cap you at about 1000 people online.
LimitNOFILE=65535
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
