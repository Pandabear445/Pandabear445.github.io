# Replace chat.example.com with your domain (its DNS A record must point at this server).
# Caddy gets a real HTTPS certificate automatically and passes WebSockets through.
chat.example.com {
	encode gzip

	# Hearth already sends its own security headers (Content-Security-Policy, X-Frame-Options, nosniff,
	# Referrer-Policy, Permissions-Policy, Cross-Origin-Opener-Policy and HSTS), so Caddy doesn't repeat them.
	# Don't announce the proxy software.
	header {
		-Server
		-Via
	}
	# "?" = only if Hearth didn't send one (a backstop, e.g. for error pages while Hearth restarts).
	# Keep each "?" header on its own line: several in one block only apply when all of them are missing.
	header ?Strict-Transport-Security "max-age=31536000; includeSubDomains"
	header ?X-Content-Type-Options "nosniff"

	# No request size limit here on purpose: uploads can be hundreds of MB, and Hearth enforces the limits
	# you set in Admin → Storage & limits itself.

	reverse_proxy hearth:3000 {
		# While Hearth restarts (updates take a second or two), hold requests and retry
		# instead of showing visitors an error page.
		lb_try_duration 30s
		lb_try_interval 250ms
	}

	# Optional access log (to `docker compose logs caddy`). Query strings are dropped because media and
	# relay-install links carry short-lived tokens in them. Remove the # signs to turn it on.
	# log {
	# 	format filter {
	# 		request>uri regexp \?.*$ ""
	# 	}
	# }
}
