# Copy this file to .env and change what you need. Every line is optional.

# Name shown in the browser tab and on the login screen
INSTANCE_NAME=Hearth

# Port and network interface to listen on
PORT=3000
HOST=0.0.0.0

# HTTPS is ON by default with an auto-generated self-signed certificate.
# Browsers only allow microphones and encryption on https:// (or localhost).
#  - Running behind Caddy/nginx that handles HTTPS? Set HTTPS=false (and see TRUST_PROXY below).
#  - Have your own certificate? Point to it here.
HTTPS=true
# SSL_CERT=/path/to/fullchain.pem
# SSL_KEY=/path/to/privkey.pem
# Extra hostnames/IPs to put in the self-signed certificate (your public IP or DDNS name)
# PUBLIC_HOSTS=203.0.113.7,myhearth.duckdns.org

# Which reverse proxies may tell Hearth a visitor's real address (the X-Forwarded-For header).
# Default: only this machine, so Caddy/nginx on the same server needs nothing here; with docker-compose.yml the
# default is its own Caddy (a value here replaces that). Otherwise: your proxy's address or subnet (e.g. 10.0.0.5
# or 172.19.0.0/16), a number of proxies in front (1), or false. Never include addresses visitors connect from:
# they could then pretend to be anyone (and slip past IP bans and rate limits). In Docker that includes the
# network's gateway (x.x.x.1) unless HEARTH_BIND=127.0.0.1.
# TRUST_PROXY=

# Who can sign up
REGISTRATION_OPEN=true
# Require a code to sign up (share it with friends). Leave empty for no code.
# REGISTRATION_CODE=pizza-night

# Max upload size per file, in MB
MAX_UPLOAD_MB=25

# GIF search. Easiest: paste the key in the app under Settings → Instance (no restart needed).
# Or set it here. Get a free key at https://developers.giphy.com/dashboard/ (choose "API").
# GIPHY_API_KEY=
# Load GIFs through this server so GIPHY never sees members' IP addresses (default true).
# GIF_PROXY=true

# Usernames that are always admins (comma-separated). Default: none; the first account created is the owner,
# who can add admins and moderators in Admin → Team & roles.
# ADMIN_USERS=alice

# Voice chat. STUN works for most home connections.
# Add a TURN relay if some friends can join voice but nobody hears them. Easiest: sudo bash scripts/setup-turn.sh
# (installs coturn locked down, and sets everything up in Hearth). By hand: use deploy/turnserver.conf, and give
# Hearth the relay's address and its static-auth-secret; everyone then gets their own 12-hour relay password.
# STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# TURN_URL=turn:turn.example.com:3478
# TURN_SECRET=
# (TURN_USERNAME / TURN_CREDENTIAL still work but are not recommended: everyone, including people you remove,
#  shares one password that never expires.)

# Where the database, uploads, certificate and at-rest key live
# DATA_DIR=./data
# Optional: provide the server key yourself (64 hex chars) instead of data/secret.key.
# Chats are end-to-end encrypted; this key only protects messages from before that upgrade.
# AT_REST_KEY=

# Push notifications (installed app / browser, when Hearth is closed).
# Keys are generated into data/vapid.json on first start. Put a real contact address here.
# VAPID_SUBJECT=mailto:you@example.com

# Desktop installers: drop files into data/downloads (or set DOWNLOADS_DIR), or link to GitHub releases.
# DESKTOP_DOWNLOAD_URL=https://github.com/you/hearth/releases/latest
