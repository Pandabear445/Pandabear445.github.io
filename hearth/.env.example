# Copy this file to .env and change what you need. Every line is optional.

# Name shown in the browser tab and on the login screen
INSTANCE_NAME=Hearth

# Port and network interface to listen on
PORT=3000
HOST=0.0.0.0

# HTTPS is ON by default with an auto-generated self-signed certificate.
# Browsers only allow microphones and encryption on https:// (or localhost).
#  - Running behind Caddy/nginx that handles HTTPS? Set HTTPS=false (and see TRUST_PROXY below).
#  - Have your own certificate? Point to it here.
HTTPS=true
# SSL_CERT=/path/to/fullchain.pem
# SSL_KEY=/path/to/privkey.pem
# Extra hostnames/IPs to put in the self-signed certificate (your public IP or DDNS name)
# PUBLIC_HOSTS=203.0.113.7,myhearth.duckdns.org

# Which reverse proxies may tell Hearth a visitor's real address (the X-Forwarded-For header).
# Default: only this machine, so Caddy/nginx on the same server needs nothing here; with docker-compose.yml the
# default is its own Caddy (a value here replaces that). Otherwise: your proxy's address or subnet (e.g. 10.0.0.5
# or 172.19.0.0/16), a number of proxies in front (1), or false. Never include addresses visitors connect from:
# they could then pretend to be anyone (and slip past IP bans and rate limits). In Docker that includes the
# network's gateway (x.x.x.1) unless HEARTH_BIND=127.0.0.1.
# TRUST_PROXY=

# Who can sign up
REGISTRATION_OPEN=true
# Require a code to sign up (share it with friends). Leave empty for no code.
# REGISTRATION_CODE=pizza-night

# Max upload size per file, in MB
MAX_UPLOAD_MB=25

# GIF search. Easiest: paste the key in the app under Settings → Instance (no restart needed).
# Or set it here. Get a free key at https://developers.giphy.com/dashboard/ (choose "API").
# GIPHY_API_KEY=
# Load GIFs through this server so GIPHY never sees members' IP addresses (default true).
# GIF_PROXY=true

# Link previews: when a member asks, this server fetches the page so their message can carry a preview card
# (inside the encryption). The server sees those links; people reading never contact the site. Default on;
# the owner can also switch it in Admin → Owner → Features.
# LINK_PREVIEWS=true
# The language sites are asked for, the same for everyone (default en).
# LINK_PREVIEW_ACCEPT_LANGUAGE=en

# Incoming webhooks: a post's own picture (avatar_url) is shown only from Discord's, GitHub's and Gravatar's
# picture hosts, so a webhook can't make this server fetch any picture on the internet. Add the hosts your
# programs use (comma-separated host names or host:port; *.example.com for every name under it). Hosts listed here
# may be on your own network (a Grafana at home, say). Other avatars show the webhook's own picture.
# WEBHOOK_AVATAR_HOSTS=grafana.com,raw.githubusercontent.com

# Usernames that are always admins (comma-separated). Each name belongs to the first account that takes it, even
# after that account renames itself. Default: none; the first account created is the owner, who can add admins
# and moderators in Admin → Team & roles. Set before anyone signs up: the first account owns the server if it
# took one of these names; if not, the first name here owns it once it's registered (until then the first
# account runs it). Names added later are admins, never the owner: hand ownership over in Admin → Team & roles,
# or run `node server/cli.js set-owner <username>`.
# ADMIN_USERS=alice

# Voice chat. STUN works for most home connections.
# Add a TURN relay if some friends can join voice but nobody hears them. Easiest: sudo bash scripts/setup-turn.sh
# (installs coturn locked down, and sets everything up in Hearth). By hand: use deploy/turnserver.conf, and give
# Hearth the relay's address and its static-auth-secret; everyone then gets their own relay password that runs out
# within 12-18 hours.
# STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# TURN_URL=turn:turn.example.com:3478
# TURN_SECRET=
# (TURN_USERNAME / TURN_CREDENTIAL still work but are not recommended: everyone, including people you remove,
#  shares one password that never expires.)

# Where the database, uploads, certificate and at-rest key live
# DATA_DIR=./data
# Optional: provide the server key yourself (64 hex chars) instead of data/secret.key.
# Chats are end-to-end encrypted; this key only protects messages from before that upgrade.
# AT_REST_KEY=
# Before a database upgrade Hearth saves a copy, data/backups/hearth-before-v<version>-<date>.db. Once an upgrade
# has gone through, only the newest few copies are kept (the one just made always stays). 0 keeps every copy.
# PRE_UPGRADE_KEEP=3

# Push notifications (installed app / browser, when Hearth is closed).
# Keys are generated into data/vapid.json on first start. Put a real contact address here: Apple's push service
# (iPhone, iPad, Mac) refuses placeholders. Without one, PUBLIC_URL is used when it's https://.
# VAPID_SUBJECT=mailto:you@yourdomain
# Which push services this server sends to. Empty: any public https one (browsers bring Google's, Mozilla's,
# Apple's or Microsoft's; the Android app brings a UnifiedPush one such as ntfy.sh). Exact names or *.suffix:
# PUSH_HOSTS=fcm.googleapis.com,*.push.services.mozilla.com,*.notify.windows.com,web.push.apple.com,ntfy.sh
# A push service on your own network (a self-hosted ntfy on the LAN or a Docker network): exact names, port 443
# unless you add one (ntfy.lan:8443). Nothing else private is reachable.
# PUSH_PRIVATE_HOSTS=ntfy.lan
# Your own ntfy (https only): the Android app's settings tell people to point the ntfy app at it.
# PUSH_NTFY_URL=https://ntfy.example.com

# Android app: open https://this-server/invite/... links straight in the app (Android App Links). The SHA-256
# fingerprint of the key the app is signed with (keytool -list -v -keystore hearth.jks); several comma-separated
# (your key and Google Play's app signing key). Only for an app built with HEARTH_SERVER set to this server.
# ANDROID_CERT_SHA256=AB:CD:...
# ANDROID_PACKAGE=app.hearth.mobile

# Disappearing messages: each message is deleted at its time by a precise timer; this sweep is the safety net.
# After a sweep that deleted something, the database's write-ahead log is reset (at most this often) so deleted
# messages' bytes don't linger in it. Backups made before a message's time keep it until they rotate out.
# DISAPPEAR_SWEEP_MS=60000
# DISAPPEAR_CHECKPOINT_MS=600000

# Desktop installers: drop files into data/downloads (or set DOWNLOADS_DIR), or link to GitHub releases.
# DESKTOP_DOWNLOAD_URL=https://github.com/you/hearth/releases/latest

# Alerts (Admin → Health). Besides the owner's email they can go to ntfy, a signed webhook, Discord or Slack
# (Admin → Health → Where alerts go). Those must be public https addresses. A service on your own network (a
# self-hosted ntfy on the LAN or a Docker network) has to be named here: exact names or addresses, on the default
# port unless you add one. Only these may use plain http; nothing else private is reachable.
# ALERT_PRIVATE_HOSTS=ntfy.lan:8080
# How long one delivery may take, in ms.
# ALERT_CHANNEL_TIMEOUT_MS=8000

# Prometheus metrics at /metrics: off unless this is set (16 characters or more, e.g. `openssl rand -hex 32`).
# Scrapers send "Authorization: Bearer <token>". Only instance-level numbers, nothing about anyone; see
# docs/OPERATIONS.md.
# METRICS_TOKEN=
