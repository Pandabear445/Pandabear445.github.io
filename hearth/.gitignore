node_modules/
*.log
desktop/node_modules/
desktop/dist/

# Server data and secrets: never commit these.
data/
data-backup*/
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
*.keystore
*.jks
# Databases and backups (Hearth backups: *.hbk)
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.hbk
*.bak

# Server update zips made by scripts/make-update-zip.sh (published with releases, never committed).
/dist/
hearth-update-*.zip
hearth-update-*.zip.sha256
hearth-update-*.zip.sig
# What copies of the old update tools (no longer part of Hearth) wrote next to themselves: a server's address and
# its update log. Never commit them.
hearth-update.json
last-update-log.txt

# Visual regression screenshots: made on the machine that checks them (see docs/ACCESSIBILITY.md).
/test/visual/baseline/
/test/visual/output/

# The Umbrel app package has to ship its empty data folder (deploy/catalogs/README.md). Nothing else goes in it.
!/deploy/catalogs/umbrel/hearth/data/
/deploy/catalogs/umbrel/hearth/data/*
!/deploy/catalogs/umbrel/hearth/data/.gitkeep
